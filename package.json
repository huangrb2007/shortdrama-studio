{
  "name": "shortdrama-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:server": "tsx apps/server/src/main.ts",
    "dev:web": "vite apps/web",
    "build:web": "vite build apps/web",
    "build:server": "esbuild apps/server/src/main.ts --bundle --platform=node --format=cjs --external:pyodide --external:node:sqlite --outfile=dist/server/main.cjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "build": "pnpm build:web && pnpm build:server",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --x64 --arm64"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@tanstack/react-virtual": "^3.10.0",
    "ajv": "^8.17.0",
    "electron-updater": "^6.8.11",
    "epub2": "^3.0.2",
    "fastify": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "pyodide": "^0.27.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "yaml": "^2.6.0"
  },
  "main": "apps/desktop/main.cjs",
  "description": "本地优先的 AI 短剧制片工作台",
  "author": "huangrb2007",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "ffmpeg-static"
    ]
  },
  "build": {
    "appId": "com.shortdrama.studio",
    "productName": "Shortdrama Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/**",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/pyodide/**"
    ],
    "extraResources": [
      {
        "from": "dist/server",
        "to": "dist/server"
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "apps/web/dist",
        "to": "apps/web/dist"
      },
      {
        "from": "node_modules/pyodide",
        "to": "dist/server/node_modules/pyodide"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "huangrb2007",
        "repo": "shortdrama-studio"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "category": "public.app-category.video"
    }
  }
}